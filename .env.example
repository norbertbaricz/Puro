# Discord Developer Portal -> Bot -> Token (never share this value).
TOKEN=
# Discord Developer Portal -> General Information -> Application ID.
clientId=
# DISCORD_TOKEN and CLIENT_ID / APPLICATION_ID aliases also work.
NODE_ENV=production
LOG_LEVEL=INFO
LOG_TIMESTAMPS=true
# Optional e621 API credentials used by the existing /e621 command.
E621_USERNAME=
E621_API_KEY=
