{
    "name": "puro",
    "version": "3.1.0",
    "description": "Puro: hot-loaded Discord plugins with consistent rich messages and a clear, tested core.",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "node --trace-warnings app.js",
        "dev:debug": "node --inspect --trace-warnings app.js",
        "check": "node tools/scripts/check.js",
        "test": "node --test --test-concurrency=1 tools/tests/*.test.js",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "prestart": "node tools/scripts/runtime.js",
        "deps:check": "node tools/scripts/versions.js",
        "verify": "npm run check && npm test && npm run lint:check && npm run format:check",
        "format": "prettier --config tools/prettier.config.cjs --ignore-path tools/.prettierignore --write .",
        "format:check": "prettier --config tools/prettier.config.cjs --ignore-path tools/.prettierignore --check ."
    },
    "dependencies": {
        "@discordjs/voice": "0.19.2",
        "@snazzah/davey": "0.1.12",
        "axios": "1.20.0",
        "chokidar": "6.0.0",
        "discord.js": "14.27.0",
        "dotenv": "18.0.9",
        "js-yaml": "5.5.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.13.0",
        "globals": "17.13.0",
        "prettier": "3.9.10"
    },
    "keywords": [
        "discord",
        "bot",
        "automation",
        "community",
        "fun",
        "discord.js",
        "slash-commands"
    ],
    "author": "MaxUltimat3",
    "company": "Skypixel",
    "license": "ISC",
    "engines": {
        "node": ">=26.12.1",
        "npm": ">=12.2.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/norbertbaricz/Puro"
    },
    "bugs": {
        "url": "https://github.com/norbertbaricz/Puro/issues"
    },
    "packageManager": "npm@12.2.1"
}
